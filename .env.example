# Copier ce fichier en .env et adapter les valeurs. Ne jamais committer .env.

# --- Backend (port HTTP local ; 8080 est souvent déjà pris sous Windows) ---
SERVER_PORT=8081

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=stagehub
DB_USERNAME=stagehub
DB_PASSWORD=change-me

# --- JWT (HS256 : au moins 32 octets, ex. `openssl rand -base64 48`) ---
JWT_SECRET=remplacer-par-une-chaine-aleatoire-d-au-moins-32-octets
JWT_EXPIRATION=PT1H

# --- Compte admin créé au démarrage ---
ADMIN_EMAIL=admin@stagehub.local
ADMIN_PASSWORD=change-me-admin

# --- Données de démo (profil dev uniquement ; comptes publics, pas un secret) ---
DEMO_PASSWORD=demo1234
