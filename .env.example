# Copier ce fichier en .env et adapter les valeurs. Ne jamais committer .env.

# --- Backend (port HTTP local ; 8080 est souvent déjà pris sous Windows) ---
SERVER_PORT=8081
# Origines autorisées par CORS (virgules) ; inutile en dev grâce au proxy Angular, utile si le front est servi ailleurs
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=stagehub
DB_USERNAME=stagehub
DB_PASSWORD=change-me

# --- JWT (HS256 : au moins 32 octets, ex. `openssl rand -base64 48`) ---
JWT_SECRET=remplacer-par-une-chaine-aleatoire-d-au-moins-32-octets
JWT_EXPIRATION=PT1H

# --- Compte admin créé au démarrage ---
ADMIN_EMAIL=admin@stagehub.local
ADMIN_PASSWORD=change-me-admin

# --- Données de démo (profil dev uniquement ; comptes publics, pas un secret) ---
DEMO_PASSWORD=demo1234

# --- Stockage des CV (dossier local ; volume Docker en phase 5) ---
CV_STORAGE_DIR=./uploads/cv

# --- Emails (Mailpit en local : SMTP 1025, interface http://localhost:8025) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@stagehub.local
MAILPIT_UI_PORT=8025
# Vrai SMTP (ex. Brevo gratuit : 300 emails/jour) : décommenter et renseigner ; laisser vide pour Mailpit.
# SMTP_HOST/SMTP_PORT : serveur utilisé par le backend conteneurisé (docker compose) ;
# MAIL_HOST/MAIL_PORT ci-dessus : backend lancé hors Docker (développement).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true

# --- Application conteneurisée (docker compose up -d --build) ---
# Port de l'application sur la machine (Nginx) : http://localhost:8090
APP_PORT=8090
# URL publique (liens dans les emails, CORS) ; sur le serveur : https://votre-domaine
PUBLIC_URL=http://localhost:8090
# prod,demo = configuration de production + comptes de démo ; une vraie production : prod
SPRING_PROFILES_ACTIVE=prod,demo
# Swagger UI (/swagger-ui.html) : true pour la démo, false en vraie production
SWAGGER_ENABLED=true
# Logs du backend : vide = texte lisible ; ecs = JSON structuré (serveur)
LOG_FORMAT=
# Mot de passe de l'interface Mailpit (/mail/), format utilisateur:motdepasse ; vide = sans mot de passe (local)
MAILPIT_UI_AUTH=
