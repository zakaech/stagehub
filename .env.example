# Copier ce fichier en .env et adapter les valeurs. Ne jamais committer .env.

# --- Monolithe lancé hors Docker (port HTTP local ; 8080 est souvent déjà pris sous Windows) ---
SERVER_PORT=8081

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=stagehub
DB_USERNAME=stagehub
DB_PASSWORD=change-me

# --- Base d'auth-service (phase 7 : une base et un rôle PostgreSQL par service, créés par postgres-init) ---
AUTH_DB_PASSWORD=change-me-auth

# --- JWT (phase 7 : RS256). Clé privée RSA d'auth-service, seul service à pouvoir signer des jetons ; les autres
# vérifient avec la clé publique qu'il publie (JWKS).
# Vide (essai local) : clé générée au premier démarrage et gardée dans le volume Docker auth-cles.
# Sur un serveur, la fournir (sauvegardée avec le reste) : clé PKCS#8 en Base64 sur une ligne :
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -outform DER | base64 -w0
JWT_PRIVATE_KEY=
JWT_EXPIRATION=PT1H

# --- Compte admin créé au démarrage (par auth-service) ---
ADMIN_EMAIL=admin@stagehub.local
ADMIN_PASSWORD=change-me-admin

# --- Données de démo : créées par le programme demo-seeder (profil compose « demo » ; comptes publics, pas un secret) ---
COMPOSE_PROFILES=demo
DEMO_PASSWORD=demo1234

# --- Stockage des CV (dossier local ; volume Docker en phase 5) ---
CV_STORAGE_DIR=./uploads/cv

# --- Emails (Mailpit en local : SMTP 1025, interface http://localhost:8025) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@stagehub.local
MAILPIT_UI_PORT=8025
# Vrai SMTP (ex. Brevo gratuit : 300 emails/jour) : décommenter et renseigner ; laisser vide pour Mailpit.
# SMTP_HOST/SMTP_PORT : serveur utilisé par le backend conteneurisé (docker compose) ;
# MAIL_HOST/MAIL_PORT ci-dessus : backend lancé hors Docker (développement).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true

# --- Application conteneurisée (docker compose up -d --build) ---
# Port de l'application sur la machine (Nginx) : http://localhost:8090
APP_PORT=8090
# URL publique (liens dans les emails, CORS) ; sur le serveur : https://votre-domaine
PUBLIC_URL=http://localhost:8090
SPRING_PROFILES_ACTIVE=prod
# Swagger UI (/swagger-ui.html) : true pour la démo, false en vraie production
SWAGGER_ENABLED=true
# Logs du backend : vide = texte lisible ; ecs = JSON structuré (serveur)
LOG_FORMAT=
# Mot de passe de l'interface Mailpit (/mail/), format utilisateur:motdepasse ; vide = sans mot de passe (local)
MAILPIT_UI_AUTH=

# --- Intégration continue Jenkins (phase 6) : docker compose -f ci/docker-compose.yml --env-file .env up -d --build ---
# Jenkins sur http://localhost:8085 ; application de recette déployée par Jenkins sur http://localhost:8095
JENKINS_PORT=8085
CI_RECETTE_PORT=8095
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me-jenkins
