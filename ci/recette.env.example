# Configuration de l'application de RECETTE déployée par Jenkins (dans DinD, http://localhost:8095).
# Copier en ci/recette.env (ignoré par git), remplacer les valeurs "change-me", puis téléverser ce fichier
# dans Jenkins comme credential "Secret file" d'identifiant stagehub-env-recette (voir docs/CI.md).
# Jenkins le passe à "docker compose --env-file" au moment du déploiement ; il n'est jamais dans le dépôt.

# Nginx écoute sur 8090 à l'intérieur de DinD ; DinD le publie sur le port 8095 du PC
APP_PORT=8090
# Adresse vue par le navigateur (liens des emails, CORS)
PUBLIC_URL=http://localhost:8095

SPRING_PROFILES_ACTIVE=prod,demo
SWAGGER_ENABLED=true
LOG_FORMAT=

DB_NAME=stagehub
DB_USERNAME=stagehub
DB_PASSWORD=change-me

# Au moins 32 octets, ex. : openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_EXPIRATION=PT1H

ADMIN_EMAIL=admin@stagehub.local
ADMIN_PASSWORD=change-me
DEMO_PASSWORD=demo1234

MAIL_FROM=no-reply@stagehub.local
MAILPIT_UI_AUTH=
